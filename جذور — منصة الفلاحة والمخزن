* { box-sizing: border-box; }

html { scroll-padding-top: env(safe-area-inset-top,0px); }

body { margin: 0px; background: radial-gradient(1200px 500px at 50% -10%,#1c1f1d,var(--bg)); color: var(--tx); font: 400 15px / 1.6 Tajawal, system-ui, sans-serif; min-height: 100vh; padding: env(safe-area-inset-top,0px) 0 env(safe-area-inset-bottom,0px); }

h1, h2, h3 { margin: 0px; font-weight: 800; }

button, input, select, textarea { font: inherit; color: var(--tx); }

