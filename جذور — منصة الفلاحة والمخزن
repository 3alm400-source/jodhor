input:focus, select:focus, button:focus-visible, textarea:focus { outline: 2px solid var(--sv); outline-offset: 1px; }

.btn { background: linear-gradient(rgb(233, 235, 239), rgb(174, 178, 187)); color: rgb(10, 10, 11); border: 0px; border-radius: 10px; padding: 10px 16px; font-weight: 800; cursor: pointer; }

.btn.g { background: var(--s2); color: var(--tx); border: 1px solid var(--ln); }

.btn.d { background: rgb(58, 23, 23); color: rgb(255, 179, 179); border: 1px solid rgb(106, 42, 42); padding: 4px 10px; }

.wrap { max-width: 1000px; margin: auto; padding: 14px; }

.top { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--ln); position: sticky; top: 0px; background: rgba(10, 10, 11, 0.933); backdrop-filter: blur(8px); z-index: 5; }

