.th5 { --bd: 1px solid #9a9ca4; --a: #9a9ca4; --hb: linear-gradient(90deg,#e9ebef,#c9ccd3); }

.th6 { --bd: 0; --a: #bbb; }

.th7 { --bd: 2px solid #111; --a: #111; --hb: #111; --hc: #fff; }

.th8 { --bd: 6px ridge #7a5c2e; --a: #7a5c2e; --hb: #f6efe2; --hc: #4a3512; --f: Georgia,serif; }

.paper::before { content: ""; position: absolute; inset: 0px; background: url("wm.png") center center / 45% auto no-repeat; opacity: 0.16; pointer-events: none; z-index: -1; }

@media print {
  body { background: rgb(255, 255, 255); color: rgb(0, 0, 0); }
