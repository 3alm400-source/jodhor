:root { --bg: #0a0a0b; --s1: #141416; --s2: #1d1d20; --ln: #34343a; --tx: #e8e9ec; --mu: #9a9ca4; --sv: #c9ccd3; --gr: #58d46a; --rd: #ff5a5a; --bl: #4ea1ff; --wh: #fff; }

