.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }

.tile { background: linear-gradient(160deg,var(--s2),var(--s1)); border: 1px solid var(--ln); border-radius: 14px; padding: 16px 10px; text-align: center; cursor: pointer; font-weight: 500; }

.tile:hover { border-color: var(--sv); }

.tile i { display: block; font-style: normal; font-size: 28px; margin-bottom: 4px; }

.row { display: flex; gap: 8px; flex-wrap: wrap; align-items: end; }

.row > * { flex: 1 1 140px; }

label { display: block; color: var(--mu); font-size: 12px; margin-bottom: 3px; }

.tw { overflow-x: auto; border: 1px solid var(--ln); border-radius: 12px; margin-top: 10px; }

table { border-collapse: collapse; width: 100%; font-size: 13px; min-width: 520px; }

th, td { padding: 8px 10px; border-bottom: 1px solid var(--ln); text-align: right; white-space: nowrap; }

th { background: var(--s2); color: var(--sv); font-weight: 500; }

.dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-inline-end: 3px; vertical-align: middle; box-shadow: currentcolor 0px 0px 8px; }

.hero { display: flex; align-items: center; gap: 16px; padding: 18px; }

.hero svg { width: 92px; height: 92px; flex: 0 0 auto; }

.hero p { margin: 4px 0px 0px; color: var(--mu); }

.tabs { display: flex; gap: 6px; flex-wrap: wrap; }

.tabs .btn { padding: 6px 12px; font-size: 13px; }

.tabs .on { outline: 2px solid var(--gr); }

.auth { max-width: 380px; margin: 8vh auto; text-align: center; }

.auth .panel { display: grid; gap: 10px; text-align: right; }

.badge { background: var(--s2); border: 1px solid var(--ln); border-radius: 20px; padding: 2px 10px; font-size: 12px; color: var(--sv); }

.big { font-size: 26px; font-weight: 800; }

video { width: 100%; border-radius: 12px; background: rgb(0, 0, 0); }

.leg span { margin-inline-end: 12px; font-size: 12px; color: var(--mu); }

.paper { white-space: normal; font-family: var(--f,Tajawal,serif); border: var(--bd,1px solid #ccc); padding: 26px 28px; }

.paper .ph { display: flex; align-items: center; gap: 12px; padding: 10px 12px; margin: -6px -8px 14px; background: var(--hb,transparent); color: var(--hc,#111); border-bottom: 2px solid var(--a,#222); }

